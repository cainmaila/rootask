{
  "name": "rootask",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "以 GitHub repo 為完整後端的任務管理 PWA",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc -p web/tsconfig.json --noEmit && tsc -p worker/tsconfig.json --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "wrangler": "^4.157.0"
  }
}
